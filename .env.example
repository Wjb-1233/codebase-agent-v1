GITHUB_TOKEN=your_github_token_here
DATABASE_URL=sqlite:///analysis.db
LOG_LEVEL=DEBUG

# RAG 检索与问答使用的模型配置
# EMBEDDING_PROVIDER=openai 使用 OpenAI Embeddings
# EMBEDDING_PROVIDER=local 使用本地 sentence-transformers，适合离线或内网环境
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 生成质量评估：heuristic 为离线规则评估，llm_judge 为线上模型评审
GENERATION_EVALUATOR=heuristic
LLM_JUDGE_MODEL=

# PostgreSQL 可选 Docker Compose profile
# DATABASE_URL=postgresql+psycopg://app_user:change_me_app@localhost:5432/codebase_agent
POSTGRES_DB=codebase_agent
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_app

# Qdrant 持久化向量库
VECTOR_STORE_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=code_chunks
QDRANT_VECTOR_SIZE=1536

# Reranker：开发/测试默认关闭；生产或质量验收环境建议开启 CrossEncoder
RERANKER_ENABLED=false
RERANKER_PROVIDER=identity
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Agent 持久化会话记忆
AGENT_MEMORY_DB_PATH=agent_memory.db

# 前端开发服务器 CORS
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
